{
    "name": "@bobanm/table-printer",
    "version": "0.3.0",
    "description": "A simple, ultra lightweight class for printing beautiful minimalistic CLI tables.",
    "author": "Boban Milošević",
    "license": "ISC",
    "keywords": ["table", "console", "terminal"],
    "type": "module",
    "main": "./dist/table-printer.js",
    "types": "./dist/table-printer.d.ts",
    "files": [ "dist" ],
    "scripts": {
        "build": "tsc --ignoreConfig table-printer.ts --target ES2022 --module ESNext --strict --noEmitOnError --declaration --outDir dist",
        "prepack": "bun run build"
    },
    "devDependencies": {
        "@types/bun": "^1.4.4",
        "typescript": "^7.0.2"
    }
}
